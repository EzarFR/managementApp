<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F3EF"
    android:padding="20dp">

    <!-- Bagian Header: Sapaan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="vertical">

        <!-- Elemen TextView -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selamat Datang."
            android:textColor="#2D2A26"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvNamaSiswa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kojar Acumalaka (Kelas XII RPL 20)"
            android:textColor="#2D3436"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Bagian Kartu Ringkasan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <!-- Kotak 1: Info Tugas-->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tugas Pending"
                android:textColor="#636E72"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvJumlahTugas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                android:textColor="#D63031"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- kotak 2 : Info Nilai -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rata - Rata Nilai"
                android:textColor="#636E72"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvRataNilai"
                android:text="88.5"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#00B894"
                android:layout_marginTop="4dp">
            </TextView>


        </LinearLayout>

    </LinearLayout>

    <!-- Bagian Judul : Daftar Tugas Terbaru -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tugas Terbaru"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#2D3436"
        android:layout_marginBottom="12dp" />

    <!-- placeholder sementara card tugas -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFF"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Object Oriented Programing(OOP)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#2D3436">
        </TextView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buat Program CRUD Sederhana"
            android:textSize="12sp"
            android:textColor="#2D3436"
            android:layout_marginTop="4dp">
        </TextView>


    </LinearLayout>



</LinearLayout>
